while True:
    num = int(input('Enter any number:'))
    
    if num % 2 == 0:
        print("This number" + str(num) + "is even")
    else: 
        print("This number" + str(num) + "is odd")
    repeat = input('Do you want to repeat?').strip().upper()
    if repeat != 'Y':
         break
print("program stop")
print("Thank you for using my program ^^")